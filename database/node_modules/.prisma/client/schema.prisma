generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  tours     Tour[]
}

model Tour {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  rooms Room[]
}

model Room {
  id          String  @id @default(cuid())
  name        String
  description String?
  panoramaUrl String
  sortOrder   Int     @default(0)

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  hotspots Hotspot[]
}

model Hotspot {
  id           String  @id @default(cuid())
  label        String
  x            Float
  y            Float
  z            Float
  targetRoomId String?

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
